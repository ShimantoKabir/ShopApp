{
  // The SDK is not on PATH on this machine, so point VS Code at it.
  "dart.flutterSdkPath": "C:\\src\\flutter",

  // Match the width this codebase is already written with (the default is 80).
  "dart.lineLength": 120,

  // Hot reload whenever a changed file is saved.
  "dart.hotReloadOnSave": "allIfDirty",

  // Show the Flutter widget guides in the editor.
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,

  // Keep build output out of search results and the file tree.
  "files.exclude": {
    "**/.dart_tool": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.dart_tool": true
  },

  // Recommended editor behaviour for Dart/Flutter.
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [120],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  }
}
